<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pulley verification probe (milestone 1). NOT part of the product.
  One invisible extension that should start by itself at app launch (StartOn) in
  After Effects and Illustrator, run a fixed set of capability checks and
  benchmarks, POST the results to tests/probes/header-logger.mjs, then quit the host.
-->
<ExtensionManifest Version="7.0" ExtensionBundleId="dev.pulley.probe" ExtensionBundleVersion="0.0.1"
  ExtensionBundleName="Pulley Probe" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="dev.pulley.probe.bg" Version="0.0.1" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[25.0,99.9]" />
      <Host Name="ILST" Version="[29.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="dev.pulley.probe.bg">
      <DispatchInfo>
        <Resources>
          <MainPath>./bg.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size>
              <Height>1</Height>
              <Width>1</Width>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
